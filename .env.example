# Safe local defaults. Generate credentials with: node scripts/ops.mjs init
COMPOSE_PROJECT_NAME=securechat
SITE_ADDRESS=http://localhost
ALLOWED_ORIGINS=http://localhost:8080
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
# Local images by default. For registry releases use ghcr.io/YOUR_USER/e2e-chatapp
IMAGE_PREFIX=securechat
APP_TAG=local
